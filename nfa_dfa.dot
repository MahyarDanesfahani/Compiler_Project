digraph DFA {
  rankdir=LR;
  node [shape=circle]; q0;
  node [shape=doublecircle]; q1 q2 q3 q4 q5 q6;
  q0 -> q1 [label="letter"];
  q1 -> q1 [label="letter,digit"];
  q0 -> q2 [label="digit"];
  q2 -> q2 [label="digit"];
  q0 -> q3 [label="+"];
  q0 -> q4 [label="="];
  q0 -> q5 [label="("];
  q0 -> q6 [label=")"];
  q0 -> q0 [label="whitespace"];
}
